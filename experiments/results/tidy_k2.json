[
 {
  "line": 0,
  "voice": "aya",
  "heard": "今ので三キロ目めっちゃ 調子いいね"
 },
 {
  "line": 1,
  "voice": "aya",
  "heard": "あと三十五秒でソウルの箱が開くからそっち行 こ"
 },
 {
  "line": 2,
  "voice": "aya",
  "heard": "一万五千ソールたまった 何 買おっかな"
 },
 {
  "line": 3,
  "voice": "aya",
  "heard": "ヘイズの二番で寝かせて そのまま倒そう"
 },
 {
  "line": 4,
  "voice": "aya",
  "heard": "リスポーンまで二十秒もある 長い な"
 },
 {
  "line": 5,
  "voice": "aya",
  "heard": "ガーディアンもう 二本折れてる 速くない"
 },
 {
  "line": 6,
  "voice": "aya",
  "heard": "えっと今十分だからそろそろミットボス行け る"
 },
 {
  "line": 7,
  "voice": "aya",
  "heard": "相手五人全員こっち来てる 下 がって 下が って"
 },
 {
  "line": 8,
  "voice": "aya",
  "heard": "ウィンディクタのウルトで三回連続でやられ た"
 },
 {
  "line": 9,
  "voice": "aya",
  "heard": "もう一回行こう今 度は一 緒に"
 },
 {
  "line": 10,
  "voice": "aya",
  "heard": "一気に詰めたら勝てる いくよ"
 },
 {
  "line": 11,
  "voice": "aya",
  "heard": "一瞬で溶けた 何今の"
 },
 {
  "line": 12,
  "voice": "aya",
  "heard": "このアイテムが一番強い と思う"
 },
 {
  "line": 13,
  "voice": "aya",
  "heard": "ナイス今 の 四千ソールはでかい"
 },
 {
  "line": 14,
  "voice": "aya",
  "heard": "残り二人 あと少 し"
 },
 {
  "line": 15,
  "voice": "aya",
  "heard": "なるほどねじゃあ 次はスピリット系でいこうか な"
 },
 {
  "line": 16,
  "voice": "aya",
  "heard": "いやそれはないでしょ 普通に負ける って"
 },
 {
  "line": 17,
  "voice": "aya",
  "heard": "ちょっと待ってまだ準備できてな い"
 },
 {
  "line": 18,
  "voice": "aya",
  "heard": "今日 も デッドロックやっていき ます"
 },
 {
  "line": 19,
  "voice": "aya",
  "heard": "そうな んですよ昨日やっとランク上がりまし た"
 },
 {
  "line": 20,
  "voice": "aya",
  "heard": "ヘイズの四番ウル トのことね あ れはタイミングが 大事"
 },
 {
  "line": 21,
  "voice": "aya",
  "heard": "二対一はさすがに無理だよ"
 },
 {
  "line": 22,
  "voice": "aya",
  "heard": "えっとジャングルの小さいキャンプを二個取ったら戻 る"
 },
 {
  "line": 23,
  "voice": "aya",
  "heard": "今五十％くらいかなもう少しでたま る"
 },
 {
  "line": 24,
  "voice": "aya",
  "heard": "これで今日七連勝 すごくない"
 },
 {
  "line": 25,
  "voice": "aya",
  "heard": "あっやばいソウル落とした"
 },
 {
  "line": 26,
  "voice": "aya",
  "heard": "うんどうし ようかなここ は 引いたほうがいい かも"
 },
 {
  "line": 27,
  "voice": "aya",
  "heard": "百ソール足りなか った 悔しい"
 },
 {
  "line": 28,
  "voice": "aya",
  "heard": "ボックスから出たのは二枚目のカードだ ね"
 },
 {
  "line": 29,
  "voice": "aya",
  "heard": "よし勝った み んなお 疲れさ ま"
 },
 {
  "line": 30,
  "voice": "aya",
  "heard": "タッチで三割くらいダメージ下がったらしい よ"
 },
 {
  "line": 31,
  "voice": "aya",
  "heard": "ラッシュに一対一で勝てるわけないじ ゃん"
 },
 {
  "line": 32,
  "voice": "aya",
  "heard": "次の試合は三十分後くらいに始め ます"
 },
 {
  "line": 33,
  "voice": "aya",
  "heard": "今のはごめん 完全に俺の ミス"
 },
 {
  "line": 34,
  "voice": "aya",
  "heard": "そっち二人いるよ 気を付け て"
 },
 {
  "line": 35,
  "voice": "aya",
  "heard": "ミラージュで十二キル 今日のベストか も"
 },
