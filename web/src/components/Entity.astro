---
// 字幕の見本の用語（アプリの EntityRef.svelte と同じく、名前の前にアイコンを出す）
interface Props {
  icon: string;
  kind: "hero" | "ability";
}
const { icon, kind } = Astro.props;
---

<span class:list={["entity", kind === "hero" ? "text-gold" : "text-sky"]}
  ><img class="icon" src={icon} alt="" width="128" height="128" /><slot /></span
>
