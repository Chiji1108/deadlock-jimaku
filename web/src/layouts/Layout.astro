---
import "../styles/global.css";
import displayFont from "../assets/fonts/noto-sans-jp-900.woff2?url";
import { siDiscord, siGithub, siTwitch } from "simple-icons";
import BrandIcon from "../components/BrandIcon.astro";
import { DISCORD, REPO, TWITCH } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** 404 のように、検索に出さないページは false */
  indexable?: boolean;
}

const SITE = "デドロ字幕";
const {
  title,
  description = "デドロ配信を、世界に。デッドロックに特化した、日本語字幕＆翻訳字幕アプリ。ランクやアイテム説明も出せます。",
  indexable = true,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : SITE;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 最初に見える大きい見出しのフォント（global.css の @font-face と同じファイル） -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="デドロ字幕の字幕の見本。色とアイコン、ふりがな、英語の翻訳が付いている" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      indexable ? (
        <>
          <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
          <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="sticky top-0 z-20 bg-paper/85 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <img src="/favicon.svg" alt="" width="28" height="28" />{SITE}
        </a>
        <div class="flex items-center gap-5 text-sm whitespace-nowrap text-muted">
                    <a href="/#pricing" class="hidden hover:text-ink sm:inline">料金</a>
          <a href="/#faq" class="hidden hover:text-ink sm:inline">よくある質問</a>
          <a href={DISCORD} aria-label="Discord のサーバー" title="Discord のサーバー" class="hover:text-ink">
            <BrandIcon icon={siDiscord} />
          </a>
          <a href={REPO} aria-label="GitHub のリポジトリ" title="GitHub のリポジトリ" class="hover:text-ink">
            <BrandIcon icon={siGithub} />
          </a>
          <a href="/#download" class="pill px-4 py-2 text-sm text-paper!">無料で入手</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-24 border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted">
        <div class="flex flex-wrap gap-5">
          <a href={DISCORD} class="hover:text-ink">Discord（不具合・要望）</a>
          <a href="/terms" class="hover:text-ink">利用規約</a>
          <a href="/privacy" class="hover:text-ink">プライバシーポリシー</a>
          <a href={`${REPO}/blob/main/LICENSE.md`} class="hover:text-ink">
            ライセンス
          </a>
        </div>
        <p>
          Deadlock は Valve Corporation の商標です。本ツールは Valve とは関係のない非公式のツールです。
          ゲームの画面・データ・アイコンは Valve の著作物です。アプリはゲームのデータとアイコンを <a
            href="https://deadlock-api.com"
            class="underline">deadlock-api</a
          > から取得しています。
        </p>
        <p class="text-xs">
        参考にしたプロジェクト: <a href="https://github.com/sayonari/jimakuChan" class="underline">音声認識字幕ちゃん</a>（sayonari さん。Chrome の音声認識の扱いの設計）、<a href="https://nmori.github.io/yncneo-Docs/" class="underline">ゆかりねっとコネクター NEO</a>（Chrome の音声認識を選ぶきっかけ）。ありがとうございます。
        </p>
        <p class="flex items-center gap-2">
          © {year} ミリちゃんねる
          <a href={TWITCH} aria-label="ミリちゃんねるの Twitch" title="ミリちゃんねるの Twitch" class="hover:text-ink">
            <BrandIcon icon={siTwitch} class="size-4" />
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
