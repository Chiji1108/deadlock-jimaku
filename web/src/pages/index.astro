---
import Layout from "../layouts/Layout.astro";

import { REPO } from "../site";
/** 最新のリリースのファイルを直接落とす（ファイル名に版の番号を付けないので、いつも最新版になる） */
const file = (name: string) => `${REPO}/releases/latest/download/${name}`;
const downloads = [
  {
    os: "windows",
    name: "Windows",
    note: "Windows 10 / 11",
    href: file("deadlock-jimaku_x64-setup.exe"),
    label: "Windows 版をダウンロード",
    help: "初めて開くと「Windows によって PC が保護されました」と出ることがあります。「詳細情報」→「実行」で進めてください",
  },
  {
    os: "mac",
    name: "macOS",
    note: "macOS 11 以降（Apple シリコン・Intel）",
    href: file("deadlock-jimaku_universal.dmg"),
    label: "Mac 版をダウンロード",
    help: "dmg を開いて、アプリを「アプリケーション」にドラッグします。初めて字幕を始めるときに、マイクの使用を許可してください",
  },
  {
    os: "linux",
    name: "Linux",
    note: "AppImage（どのディストリビューションでも）",
    href: file("deadlock-jimaku_amd64.AppImage"),
    label: "AppImage をダウンロード",
    help: "AppImage は、ファイルのプロパティで「プログラムとして実行」を許可してから開きます（chmod +x でも可）。Ubuntu などは .deb、Fedora などは .rpm も使えます",
    more: [
      { label: ".deb", href: file("deadlock-jimaku_amd64.deb") },
      { label: ".rpm", href: file("deadlock-jimaku.x86_64.rpm") },
    ],
  },
] as const;

const features = [
  {
    title: "リアルタイム字幕",
    body: "話している途中から字幕が出て、話し終えると精度の高い文に置き換わります。ヒーロー・アイテム・スキルの名前は色付きで強調し、「拡マガ」「ウルト」のような略し方も聞き分けます。",
  },
  {
    title: "ふりがなと翻訳",
    body: "漢字にはふりがなを付け、英語や韓国語など最大 4 つの言語に同時に翻訳します。翻訳ではゲーム内の正式な名前に置き換わるので、海外の視聴者にも伝わります。",
  },
];

/**
 * 配信画面の見本（Windows の OBS で撮った実際の配信画面。試合 ID とキルログの名前はぼかしてある）。
 * 各オーバーレイの位置（画面の px）から、上の枠と下の拡大図の両方を作る
 */
const SCREEN = { src: "/sample/game.webp", width: 1920, height: 1080 };
const parts = [
  {
    name: "字幕",
    rect: { x: 600, y: 670, w: 740, h: 245 },
    label: "top-start",
    alt: "字幕（ドアマンのウルトは強い。デスチーターにはカースを買え。と、その英訳）",
    body: "話した言葉に、アイコン・色・ふりがなを付けて出します。下の行は英訳で、「ウルト」「カース」のような呼び方も正式な名前（Hotel Guest、Cursed Relic）になります。",
  },
  {
    name: "アイテム説明",
    rect: { x: 1500, y: 210, w: 412, h: 432 },
    label: "top-end",
    alt: "アイテム説明のカード（デスチーター）",
    body: "字幕にアイテム名が出たら、ゲーム内と同じカードで説明を出します。",
  },
  {
    name: "ランク",
    rect: { x: 6, y: 5, w: 336, h: 86 },
    label: "bottom-start",
    alt: "ランクの表示（エミッサリー III）",
    body: "今のランクと、次のランクまでのポイントを出します。試合が終わると自動で更新します。",
  },
] as const;

type Rect = (typeof parts)[number]["rect"];
/** 上の画面の上の枠の位置（画面に対する %） */
const frameStyle = ({ x, y, w, h }: Rect) =>
  `left:${(x / SCREEN.width) * 100}%;top:${(y / SCREEN.height) * 100}%;` +
  `width:${(w / SCREEN.width) * 100}%;height:${(h / SCREEN.height) * 100}%`;
/** 拡大図: 同じ画面を背景にして、その部分だけを見せる（切り出した画像を別に持たない） */
const zoomStyle = ({ x, y, w, h }: Rect) =>
  `max-width:${w}px;aspect-ratio:${w}/${h};background-image:url(${SCREEN.src});` +
  `background-size:${(SCREEN.width / w) * 100}% auto;` +
  `background-position:${(x / (SCREEN.width - w)) * 100}% ${(y / (SCREEN.height - h)) * 100}%`;

const steps = [
  { title: "ダウンロード", body: "Windows・Mac・Linux 用のアプリを入れます。" },
  {
    title: "OpenAI の API キーを設定",
    body: "文字起こしと翻訳に使います。キーは PC の資格情報ストアに保存します。",
  },
  {
    title: "OBS に URL を貼る",
    body: "アプリの画面でコピーした URL を、OBS のブラウザソースに貼るだけです。見せ方はアプリの画面で変えられます。",
  },
];

const faqs = [
  {
    q: "ゲームの PC に何か入れたり、ゲームのファイルを触ったりしますか？",
    a: "しません。マイクの声と、公開されているランクの情報だけを使います。",
  },
  {
    q: "日本語以外で話しても使えますか？",
    a: "使えます。話す言語は操作画面で選べます。ふりがなは日本語のときだけ付きます。",
  },
  {
    q: "OpenAI の料金が心配です",
    a: "アプリの「料金」タブに、使った分の目安がその場で出ます。OpenAI のダッシュボードで上限を決めておくと安心です。",
  },
];
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 pt-20 pb-16">
    <p class="text-sm font-medium text-gold">デドロ字幕</p>
    <h1 class="mt-3 text-4xl leading-tight font-bold tracking-tight sm:text-6xl">日本のデドロ配信を世界に。</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">
      デッドロックに特化した、日本語字幕＆翻訳字幕アプリ。ランクやアイテム説明も OBS
      にそのまま重ねられます。アプリは無料です。
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <!-- ダウンロードの節へ（初めて開くときの警告の進め方を見てから落としてもらう） -->
      <a
        href="#download"
        class="rounded-lg bg-gold px-5 py-3 font-semibold text-ink transition hover:brightness-110"
      >
        ダウンロード
      </a>
      <a href="#download" class="text-sm text-muted underline">
        Windows 10 / 11・macOS 11 以降・Linux
      </a>
    </div>

    <!-- 配信画面の見本: OBS で撮った実際の画面に、どれが何かを枠で示す（枠は画面の幅に合わせて縮む） -->
    <figure class="mt-14">
      <div class="relative overflow-hidden rounded-xl border border-line">
        <img
          src={SCREEN.src}
          alt="配信画面の見本。左上にランク、右にアイテム説明のカード、下の中央に字幕"
          width={SCREEN.width}
          height={SCREEN.height}
          fetchpriority="high"
          class="block w-full"
        />
        <!-- 名札は画像の説明（alt）と同じことなので読み上げない -->
        <div aria-hidden="true">
          {
            parts.map(({ name, rect, label }) => (
              <div class="frame" style={frameStyle(rect)}>
                <span class={`frame-label ${label}`}>{name}</span>
              </div>
            ))
          }
        </div>
      </div>
      <figcaption class="mt-3 text-xs text-muted">
        Windows の OBS で撮った実際の配信画面。字幕・アイテム説明・ランクは、どれも好きな位置と大きさに置けます
      </figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">できること</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        features.map((f) => (
          <div class="rounded-xl border border-line bg-panel p-6">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">オーバーレイ</h2>
    <p class="mt-3 text-muted">
      上の配信画面を拡大したところです。どれも OBS のブラウザソースに URL を貼るだけで、背景は透明なのでゲーム画面にそのまま重なります。
    </p>
    <div class="mt-8 grid items-start gap-6 sm:grid-cols-2">
      {
        parts.map((o, i) => (
          <figure class:list={["stage p-6", i === 0 && "sm:col-span-2"]}>
            <div
              role="img"
              aria-label={o.alt}
              class="mx-auto w-full rounded-md bg-no-repeat"
              style={zoomStyle(o.rect)}
            />
            <figcaption class="mt-5">
              <h3 class="font-semibold">{o.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{o.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">はじめかた</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-line p-6">
            <span class="text-sm font-semibold text-gold">{i + 1}</span>
            <h3 class="mt-2 font-semibold">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="download" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">ダウンロード</h2>
    <p class="mt-3 text-muted">無料です。いつも最新版が落ちてきます。</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        downloads.map((d) => (
          <div class="download rounded-xl border border-line bg-panel p-6" data-os={d.os}>
            <h3 class="font-semibold">{d.name}</h3>
            <p class="mt-1 text-xs text-muted">{d.note}</p>
            <a
              href={d.href}
              class="download-main mt-5 block rounded-lg border border-gold/60 px-4 py-2.5 text-center text-sm font-semibold text-gold transition hover:bg-gold hover:text-ink"
            >
              {d.label}
            </a>
            {"more" in d && (
              <p class="mt-3 flex gap-4 text-sm">
                {d.more.map((m) => (
                  <a href={m.href} class="text-muted underline hover:text-white">
                    {m.label}
                  </a>
                ))}
              </p>
            )}
            <p class="mt-4 text-xs leading-relaxed text-muted">{d.help}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      ほかの版や変更点は <a href={`${REPO}/releases`} class="underline hover:text-white">GitHub のリリース</a> にあります。
    </p>
  </section>

  <script>
    // 見ている OS の欄を目立たせる。iPad は Mac と同じ UA を名乗るので、タッチで見分ける。
    // Linux の AppImage は x86_64 用なので、ほかの CPU では目立たせない
    const ua = navigator.userAgent;
    const touch = navigator.maxTouchPoints > 1;
    const rules: [boolean, string][] = [
      [/Android|iPhone|iPad/.test(ua) || (/Macintosh/.test(ua) && touch), ""],
      [/Windows/.test(ua), "windows"],
      [/Macintosh/.test(ua), "mac"],
      [/Linux x86_64/.test(ua), "linux"],
    ];
    const os = rules.find(([match]) => match)?.[1];
    if (os) document.querySelector(`.download[data-os="${os}"]`)?.classList.add("current");
  </script>

  <section id="pricing" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">料金</h2>
    <div class="mt-8 rounded-xl border border-line bg-panel p-6 sm:p-8">
      <p class="text-lg">
        アプリは<strong class="text-gold">無料</strong>です。文字起こしと翻訳には、ご自身の OpenAI
        の API キーを使います。
      </p>
      <p class="mt-4 text-muted">
        OpenAI への支払いの目安は、ずっと話し続けて <strong class="text-white">1 時間あたり約 $2</strong>（翻訳
        1 言語・ふりがなあり）です。話していない間は音声を送らないので、黙っている時間が長いほど少なくなります。翻訳先を
        1 つ増やすと、話し続けて 1 時間あたり約 $0.3 増えます。
      </p>
    </div>
  </section>

  <section id="faq" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">よくある質問</h2>
    <dl class="mt-8 divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <div class="py-6">
            <dt class="font-semibold">{f.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
