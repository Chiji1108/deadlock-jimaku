---
import Layout from "../layouts/Layout.astro";
import RankBadge from "../../../frontend/src/lib/RankBadge.svelte";
import LiveDemo from "../components/LiveDemo.svelte";
import PlateCaption from "../components/PlateCaption.svelte";
import PlateCard from "../components/PlateCard.svelte";
import { fetchCards } from "../lib/cards";
import { LINES, RANK } from "../lib/demo";
import { DISCORD, REPO, TWITCH } from "../site";
/** 最新のリリースのファイルを直接落とす（ファイル名に版の番号を付けないので、いつも最新版になる） */
const file = (name: string) => `${REPO}/releases/latest/download/${name}`;
const downloads = [
  {
    os: "windows",
    name: "Windows",
    note: "Windows 10 / 11",
    href: file("deadlock-jimaku_x64-setup.exe"),
    label: "Windows 版をダウンロード",
    help: "初めて開くと「Windows によって PC が保護されました」と出ることがあります。「詳細情報」→「実行」で進めてください",
  },
  {
    os: "mac",
    name: "macOS",
    note: "macOS 11 以降（Apple シリコン・Intel）",
    href: file("deadlock-jimaku_universal.dmg"),
    label: "Mac 版をダウンロード",
    help: "dmg を開いて、アプリを「アプリケーション」にドラッグします。初めて字幕を始めるときに、マイクの使用を許可してください",
  },
  {
    os: "linux",
    name: "Linux",
    note: "AppImage（どのディストリビューションでも）",
    href: file("deadlock-jimaku_amd64.AppImage"),
    label: "AppImage をダウンロード",
    help: "AppImage は、ファイルのプロパティで「プログラムとして実行」を許可してから開きます（chmod +x でも可）。Ubuntu などは .deb、Fedora などは .rpm も使えます",
    more: [
      { label: ".deb", href: file("deadlock-jimaku_amd64.deb") },
      { label: ".rpm", href: file("deadlock-jimaku.x86_64.rpm") },
    ],
  },
] as const;

const keySteps = [
  {
    title: "OpenAI の開発者向けサイトに登録する",
    body: "メールアドレスか Google アカウントで登録します。ChatGPT のアカウントがあれば、それでログインできます。ChatGPT の有料プランとは別の支払いになります。",
    link: { href: "https://platform.openai.com/signup", label: "登録ページを開く" },
  },
  {
    title: "クレジットカードを登録して、前払いでチャージする",
    body: "設定の「Billing」で「Add payment method」からカードを登録し、「Add to credit balance」で 5〜10 ドルほどチャージします。使った分だけ残高から引かれます。使いすぎが心配なら、自動チャージ（Auto recharge）はオフのままにしてください。",
    link: {
      href: "https://platform.openai.com/settings/organization/billing/overview",
      label: "Billing を開く",
    },
  },
  {
    title: "API キーを作る",
    body: "「API keys」で「Create new secret key」を押し、名前（例: デドロ字幕）を付けて作ります。キーは作ったときに一度しか表示されないので、すぐにコピーしてください。",
    link: { href: "https://platform.openai.com/api-keys", label: "API keys を開く" },
  },
  {
    title: "アプリに貼り付けて保存する",
    body: "アプリの「API キー」のタブに貼り付けます。キーは PC の資格情報ストアに保存します。キーは他の人に見せないでください（使われると、あなたの残高から引かれます）。",
  },
];

const steps = [
  { title: "ダウンロード", body: "Windows・Mac・Linux 用のアプリを入れます。" },
  {
    title: "API キーかギフトコードを設定",
    body: "おすすめのモードは、確定の字幕に OpenAI を使います。無料のローカル AI モードなら要りません。キーの作り方はアプリの中でも案内します。知り合いからギフトコードをもらった場合は、キーは要りません。",
    link: { href: "#openai-key", label: "作り方を見る" },
  },
  {
    title: "OBS に追加",
    body: "アプリの画面のボタンを OBS にドラッグするだけです。見せ方はアプリの画面で変えられます。",
  },
];

const faqs = [
  {
    q: "日本語以外で話しても使えますか？",
    a: "使えます。話す言語は操作画面で選べます。ふりがなは日本語のときだけ付きます。",
  },
  {
    q: "OpenAI の料金が心配です",
    a: "アプリの「料金」タブに、使った分の目安がその場で出ます。前払いのチャージで使い、自動チャージをオフにしておけば、残高より多くは使われません。",
  },
  {
    q: "OpenAI の API キーを作らずに使えますか？",
    a: "使えます。無料のローカル AI モードならキーは要りません。OpenAI の精度を使いたいときは、Discord のサーバーで声をかけてもらえれば、お試し用のギフトコードをお渡しします。アプリの「API キー」のタブに入れるだけで使えます。知り合いからコードをもらって使うこともできて、その場合の料金はコードをくれた人の OpenAI アカウントに請求されます。API キーを持っている人は、アプリの「おすそ分け」のタブでコードを作れます。",
    link: { href: DISCORD, label: "Discord のサーバーに参加する" },
  },
  {
    q: "どのモデルを使っていますか？",
    a: "ローカル AI を使うモードでは、PC の中の SenseVoice（音声認識）と Bergamot（翻訳）で途中の字幕を作ります。OpenAI モードの途中の字幕は GPT-Live-Transcribe、確定した字幕は GPT-Transcribe、用語の判定・翻訳・ふりがなは GPT-6.1 Terra です。",
  },
  {
    q: "どんな情報が送信されますか？",
    a: "字幕を出している間の話し声と字幕の文字を OpenAI に送ります。無料のローカル AI モードでは、音声も字幕も外に送りません。ランクを出すときは、Steam のアカウント ID を deadlock-api に送ります。デドロ字幕のサーバーを通るのはおすそ分けのときだけで、音声や字幕の文字は保存しません。",
    link: { href: "/privacy", label: "プライバシーポリシーを見る" },
  },
  {
    q: "OpenAI の API キーはどこに保存されますか？",
    a: "キーは PC の OS の資格情報ストア（Windows の資格情報マネージャー、Mac のキーチェーン）に保存し、ふだんは OpenAI との通信にだけ使います。おすそ分けを始めるときだけ、確認のうえでデドロ字幕のサーバーに暗号化して預けます。",
    link: { href: "/privacy", label: "プライバシーポリシーを見る" },
  },
  {
    q: "ゲームのファイルを変更しますか？",
    a: "しません。ゲームとは別に動くアプリで、ランクは公開されている情報を使います。",
  },
  {
    q: "ウイルスが入っていないか心配です",
    a: "ソースコードは GitHub で公開していて、配布するファイルは GitHub Actions でそのコードから作っています。Windows で「PC が保護されました」と出ることがありますが、Windows 用のコード署名をしていないためで、ウイルスが見つかったという意味ではありません。",
    link: { href: REPO, label: "GitHub でソースコードを見る" },
  },
  {
    q: "どんな人が開発したんですか？",
    a: "Twitch で Deadlock を配信しているミリちゃんねるが、配信者目線で開発しました。",
    photo: "/media/miri.webp",
    link: { href: TWITCH, label: "Twitch のチャンネルを見る" },
  },
  {
    q: "わからないことは、どこで聞けますか？",
    a: "Discord のサーバーで、質問などを受け付けています。",
    link: { href: DISCORD, label: "Discord のサーバーに参加する" },
  },
];

/** 字幕の作り方 */
const modes = [
  {
    name: "ローカル AI + OpenAI",
    badge: "おすすめ",
    traits: ["高速", "ふりがな", "デッドロックモード"],
    price: "約 $0.6／時間",
    body: "話している途中の字幕と翻訳は PC の中で作り、確定の字幕は OpenAI。声を出してすぐ字幕が出て、最後は高い精度に置き換わります。",
    needs: "API キーかギフトコード",
  },
  {
    name: "OpenAI",
    traits: ["低負荷", "ふりがな", "デッドロックモード"],
    price: "約 $1／時間",
    body: "すべてクラウドで処理します。モデルを動かさないので、PC の負荷がいちばん小さいです。",
    needs: "API キーかギフトコード",
  },
  {
    name: "ローカル AI",
    traits: ["無料", "高速", "ふりがな"],
    price: "無料",
    body: "すべて PC の中で作ります。音声は外に送られません。精度は下がり、用語の強調とアイテム説明は使えません。日本語の配信で、翻訳先は英語・ロシア語・中国語です。",
    needs: "なし",
  },
];

const line = LINES[0]!;
/** 手元の測定（M5 Pro）とリリースのファイルの大きさ */
const lightness = [
  { value: "約 1%", label: "CPU", note: "字幕を出している間の、1 コアに対する割合" },
  { value: "約 20MB", label: "メモリ", note: "Windows でウィンドウを閉じて、字幕を出しているとき" },
  { value: "約 6MB", label: "インストーラー", note: "Windows 版" },
];
const cards = await fetchCards();
/** 「カート」と話しても、翻訳では正式名になる例 */
const official = [
  { lang: "English", name: "Luggage Cart" },
  { lang: "Русский", name: "Багажная тележка" },
  { lang: "中文", name: "行李车" },
];
---

<Layout>
  <section class="dots px-4 pt-8 sm:pt-7">
    <div class="mx-auto max-w-6xl text-center">
      <h1 class="display text-[clamp(2.5rem,5.6vw,4.5rem)]">デドロ配信を、<wbr /><span class="band">世界に。</span></h1>
      <p class="mt-4 text-lg text-muted">デッドロックに特化した、日本語字幕＆翻訳字幕アプリ</p>
      <p class="mt-1 text-sm text-muted">Windows 10 / 11・macOS 11 以降・Linux</p>
    </div>

    <LiveDemo client:load cards={cards} />
  </section>

  <section class="mx-auto mt-24 grid max-w-6xl items-center gap-10 px-4 sm:mt-32 md:grid-cols-2">
    <div>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">
        聞き取りの<br /><span class="band">精度が違う。</span>
      </h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        OpenAI の最新モデルで文字起こしします。略して呼んでも、どのアイテムやスキルのことか見分けます。
      </p>
    </div>
    <div class="reveal plate relative h-64 overflow-hidden">
      <div class="plate-caption"><PlateCaption client:visible stage="enriched" line={1} /></div>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div class="reveal plate relative h-64 overflow-hidden">
      <div class="plate-caption"><PlateCaption client:visible stage="translated" line={0} /></div>
    </div>
    <div class="order-first md:order-none">
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">
        <span class="band">ふりがな</span>付きで、<br />海外の学習者にも。
      </h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        漢字に読みが付くので、日本語を学んでいる海外の視聴者にも読みやすい字幕になります。英語やロシア語など、最大 4 つの言語への翻訳も同時に出せます。
      </p>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal max-w-4xl text-[clamp(2.1rem,5.4vw,4.25rem)]">
      <span class="band">デッドロック特化。</span>
    </h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      ヒーロー・スキル・アイテムの名前は色とアイコンで強調します。アイテムの名前が出たら、ゲーム内と同じカードで説明も出します。略して話しても、翻訳はゲーム内の正式な名前になります。
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <figure class="reveal">
        <div class="plate flex min-h-[26rem] items-center justify-center p-6">
          <PlateCard client:visible card={cards[line.card]!} />
        </div>
        <figcaption class="mt-4">
          <h3 class="text-xl font-bold">アイテム説明</h3>
          <p class="mt-1 leading-relaxed text-muted">話したアイテムの説明が、そのまま配信に出ます。</p>
        </figcaption>
      </figure>
      <figure class="reveal">
        <div class="flex min-h-[26rem] flex-col justify-center rounded-[20px] bg-panel p-6 sm:p-8">
          <p class="text-sm font-bold text-muted">話した言葉</p>
          <p class="display mt-1 text-4xl">「カート」</p>
          <dl class="mt-6 divide-y divide-line border-t border-line">
            {
              official.map((o) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-sm text-muted">{o.lang}</dt>
                  <dd class="text-right text-lg font-bold">{o.name}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <figcaption class="mt-4">
          <h3 class="text-xl font-bold">正式名への翻訳</h3>
          <p class="mt-1 leading-relaxed text-muted">海外の視聴者にも、何の話か伝わります。</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">ランクは、<br /><span class="band">シンプルに。</span></h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        配信にはランクだけを、すっきり出せます。アイコンだけにもできて、ランク名は英語にもできます。試合が終わると自動で更新します。
      </p>
    </div>
    <div class="reveal plate plate-rank flex flex-col items-center justify-center gap-5 p-6 sm:p-8">
      <div role="img" aria-label="ランクの表示（エミッサリー III とゲージ）">
        <RankBadge rank={RANK} lang="ja" content="gauge" />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div role="img" aria-label="英語の名前のランクの表示（Emissary III）">
          <RankBadge rank={RANK} lang="en" content="name" />
        </div>
        <div role="img" aria-label="アイコンだけのランクの表示">
          <RankBadge rank={RANK} lang="ja" content="icon" />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      ゲームの<span class="band">邪魔をしない。</span>
    </h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      文字起こしはクラウドで動くので、ゲーム中の PC に重い処理をさせません。アプリの本体は Rust で作っているので、小さくて軽いです。
    </p>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        lightness.map((l) => (
          <li class="reveal border-t-2 border-ink pt-4">
            <p class="display text-5xl">{l.value}</p>
            <h3 class="mt-2 font-bold">{l.label}</h3>
            <p class="mt-1 text-sm text-muted">{l.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 text-center sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      OBS に<span class="band">ドラッグするだけ。</span>
    </h2>
    <p class="reveal mx-auto mt-5 max-w-2xl text-lg text-muted">
      見せ方はアプリの画面で変えられます。一度追加すれば、貼り直す必要はありません。
    </p>
    <video
      data-play-in-view
      class="reveal mx-auto mt-10 w-full rounded-[clamp(14px,2.2vw,28px)]"
      src="/media/obs.mp4"
      poster="/media/obs.webp"
      width="1280"
      height="658"
      muted
      loop
      playsinline
      preload="none"
      aria-label="アプリのボタンを OBS にドラッグすると、字幕のソースができる画面録画"
    ></video>
  </section>

  <section id="modes" class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      3 つの<span class="band">モード</span>から選べる。
    </h2>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        modes.map((m) => (
          <li class="reveal border-t-2 border-ink pt-4">
            <h3 class="flex items-center gap-2 text-xl font-bold">
              {m.name}
              {m.badge && <span class="bg-ink px-2 py-0.5 text-xs text-paper">{m.badge}</span>}
            </h3>
            <p class="mt-2 text-sm font-bold">{m.traits.join("・")}</p>
            <p class="display mt-3 text-3xl">{m.price}</p>
            <p class="mt-3 leading-relaxed text-muted">{m.body}</p>
            <p class="mt-2 text-sm text-muted">必要なもの: {m.needs}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="pricing" class="mt-28 bg-ink text-paper sm:mt-40">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:py-28 md:grid-cols-2">
      <div>
        <h2 class="text-sm font-bold text-gold">料金</h2>
        <p class="display mt-3 text-[clamp(2.6rem,7vw,5.5rem)]">アプリは無料。</p>
        <p class="mt-5 text-lg leading-relaxed text-paper/70">
          無料のローカル AI モードのほかは、ご自身の
          <a href="#openai-key" class="underline hover:text-paper">OpenAI の API キー</a>を使います。
        </p>
      </div>
      <div class="md:pt-9">
        <p class="display text-[clamp(2.6rem,7vw,5.5rem)] text-gold">約 $0.6<span class="text-2xl text-paper">／時間</span></p>
        <p class="mt-5 leading-relaxed text-paper/70">
          おすすめのモードで OpenAI に払う目安です。話していない間は音声を送らず料金もかからないので、配信で話す時間が半分くらいなら 1 時間あたり約 $0.6 です（翻訳 1 言語・ふりがなあり）。OpenAI モードは約 $1 で、ずっと話し続けると約 $2 になり、翻訳先を 1 つ増やすと、話し続けて 1 時間あたり約 $0.3 増えます。
        </p>
        <p class="mt-3 leading-relaxed text-paper/70">
          ギフトコードで使うときは、自分には請求されません。使った分は、コードをくれた人の OpenAI アカウントに請求されます。
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">はじめかた</h2>
    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="reveal border-t-2 border-ink pt-4">
            <span class="display text-5xl">{i + 1}</span>
            <h3 class="mt-3 text-xl font-bold">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{s.body}</p>
            {s.link && (
              <a class="mt-2 inline-block underline" href={s.link.href}>
                {s.link.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section id="download" class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">ダウンロード</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        downloads.map((d) => (
          <div class="download reveal rounded-[20px] border border-line bg-panel p-6" data-os={d.os}>
            <h3 class="text-2xl font-black">{d.name}</h3>
            <p class="mt-1 text-sm text-muted">{d.note}</p>
            <a href={d.href} class="pill mt-5 w-full px-4 py-3 text-sm">
              {d.label}
            </a>
            {"more" in d && (
              <p class="mt-3 flex gap-4 text-sm">
                {d.more.map((m) => (
                  <a href={m.href} class="text-muted underline hover:text-ink">
                    {m.label}
                  </a>
                ))}
              </p>
            )}
            <p class="mt-4 text-sm leading-relaxed text-muted">{d.help}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      ほかの版や変更点は <a href={`${REPO}/releases`} class="underline hover:text-ink">GitHub のリリース</a> にあります。
    </p>

    <details id="openai-key" class="mt-12 border-y border-line py-6">
      <summary class="cursor-pointer text-xl font-bold">OpenAI の API キーの作り方</summary>
      <p class="mt-4 text-muted">
        文字起こしと翻訳は OpenAI に頼むので、OpenAI の API キーが必要です。支払いは使った分だけです。デドロ字幕を使っている人からコードをもらった場合は、キーがなくても使えます。アプリの「API
        キー」のタブの「ギフトコード」に入れてください。
      </p>
      <ol class="mt-6 flex flex-col gap-5">
        {
          keySteps.map((s, i) => (
            <li class="flex gap-4">
              <span class="display w-6 shrink-0 text-2xl">{i + 1}</span>
              <div>
                <h3 class="font-bold">{s.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">{s.body}</p>
                {s.link && (
                  <a class="mt-1 inline-block text-sm underline" href={s.link.href} target="_blank" rel="noreferrer">
                    {s.link.label}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </details>
  </section>

  <section id="faq" class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">よくある質問</h2>
    <div class="mt-10 border-b border-line">
      {
        faqs.map((f) => (
          <details class="border-t border-line py-5">
            <summary class="cursor-pointer text-lg font-bold">{f.q}</summary>
            {f.photo && (
              <img
                src={f.photo}
                alt="ミリちゃんねる"
                width="480"
                height="480"
                loading="lazy"
                class="mt-3 size-20 rounded-full object-cover"
              />
            )}
            <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
            {f.link && (
              <a class="mt-2 inline-block underline" href={f.link.href}>
                {f.link.label}
              </a>
            )}
          </details>
        ))
      }
    </div>
  </section>

  <script>
    // 「作り方を見る」のリンクから来たら、閉じている節を開く
    const guide = document.querySelector("details#openai-key") as HTMLDetailsElement;
    if (location.hash === "#openai-key") guide.open = true;
    for (const link of document.querySelectorAll('a[href="#openai-key"]'))
      link.addEventListener("click", () => (guide.open = true));

    // 動画は見えている間だけ再生する（OS の「動きを減らす」では再生しない）
    const videos = new IntersectionObserver((entries) => {
      for (const { isIntersecting, target } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) void video.play().catch(() => {});
        else video.pause();
      }
    });
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
      for (const video of document.querySelectorAll("[data-play-in-view]")) videos.observe(video);

    // 見ている OS の欄を目立たせる。iPad は Mac と同じ UA を名乗るので、タッチで見分ける。
    // Linux の AppImage は x86_64 用なので、ほかの CPU では目立たせない
    const ua = navigator.userAgent;
    const touch = navigator.maxTouchPoints > 1;
    const rules: [boolean, string][] = [
      [/Android|iPhone|iPad/.test(ua) || (/Macintosh/.test(ua) && touch), ""],
      [/Windows/.test(ua), "windows"],
      [/Macintosh/.test(ua), "mac"],
      [/Linux x86_64/.test(ua), "linux"],
    ];
    const os = rules.find(([match]) => match)?.[1];
    if (os) document.querySelector(`.download[data-os="${os}"]`)?.classList.add("current");
  </script>
</Layout>
