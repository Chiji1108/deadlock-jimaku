---
import miri from "../assets/miri.webp?url";
import obsPoster from "../assets/obs-drag.webp?url";
import obsVideo from "../assets/obs-drag.mp4?url";
import statsDays from "../assets/stats-days.webp?url";
import statsTotals from "../assets/stats-totals.webp?url";
import purchases from "../assets/purchases.webp?url";
import { siTwitch } from "simple-icons";
import Layout from "../layouts/Layout.astro";
import { MODES, price } from "../../../frontend/src/lib/engines";
import RankBadge from "../../../frontend/src/lib/RankBadge.svelte";
import BrandIcon from "../components/BrandIcon.astro";
import LiveDemo from "../components/LiveDemo.svelte";
import LookDemo from "../components/LookDemo.svelte";
import PlateCaption from "../components/PlateCaption.svelte";
import PlateCard from "../components/PlateCard.svelte";
import { fetchCards } from "../lib/cards";
import { LINES, RANK } from "../lib/demo";
import { STREAMERS } from "../lib/streamers";
import { DISCORD, REPO, TWITCH } from "../site";
/** 最新のリリースのファイルを直接落とす（ファイル名に版の番号を付けないので、いつも最新版になる） */
const file = (name: string) => `${REPO}/releases/latest/download/${name}`;
const downloads = [
  {
    os: "windows",
    name: "Windows",
    note: "Windows 10 / 11",
    href: file("deadlock-jimaku_x64-setup.exe"),
    label: "Windows 版をダウンロード",
    help: "初めて開くと「Windows によって PC が保護されました」と出ることがあります。「詳細情報」→「実行」で進めてください",
  },
  {
    os: "mac",
    name: "macOS",
    note: "macOS 11 以降（Apple シリコン・Intel）",
    href: file("deadlock-jimaku_universal.dmg"),
    label: "Mac 版をダウンロード",
    help: "dmg を開いて、アプリを「アプリケーション」にドラッグします。初めて字幕を始めるときに、マイクの使用を許可してください",
  },
  {
    os: "linux",
    name: "Linux",
    note: "AppImage（どのディストリビューションでも）",
    href: file("deadlock-jimaku_amd64.AppImage"),
    label: "AppImage をダウンロード",
    help: "AppImage は、ファイルのプロパティで「プログラムとして実行」を許可してから開きます（chmod +x でも可）。Ubuntu などは .deb、Fedora などは .rpm も使えます",
    more: [
      { label: ".deb", href: file("deadlock-jimaku_amd64.deb") },
      { label: ".rpm", href: file("deadlock-jimaku.x86_64.rpm") },
    ],
  },
] as const;

const steps = [
  { title: "ダウンロード", body: "Windows・Mac・Linux 用のアプリを入れます。" },
  {
    title: "OBS に追加",
    body: "アプリの画面のボタンを OBS にドラッグするだけです。",
  },
  {
    title: "字幕を始める",
    body: "まずは無料の Chrome のモードで始まります（Google Chrome が必要です）。「モード」のタブで「おすすめ」を選ぶと、キーなしで、もっと正確な字幕と翻訳になります。",
  },
];

const faqs = [
  {
    q: "日本語以外で話しても使えますか？",
    a: "使えます。話す言語は操作画面で選べます。ふりがなは日本語のときだけ付きます。",
  },
  {
    q: "お金はかかりますか？",
    a: "かかりません。Chrome のモードは無料で、「おすすめ」のモードもベータ期間中は無料です。API キーも要りません。API キーを使うモードを選んだときだけ、ご自身の API キーで各社に使った分を払います。アプリの「API キーと料金」のタブに、使った分の目安がその場で出ます。",
  },
  {
    q: "「おすすめ」のモードは、配信の途中で止まりませんか？",
    a: "止まりません。「おすすめ」のモードには 1 日に使える量の上限がありますが、届いても字幕は消えず、Chrome のモードと同じ作り方に切り替わって続きます。ベータ期間中の無料の提供は、予告なく変えたり終えたりすることがあります。",
  },
  {
    q: "字幕はどこで作っていますか？",
    a: "初めに選べる 3 つのモード（おすすめ・Chrome・Chrome+）は、話している途中の字幕を Chrome で作ります（Google Chrome が必要で、字幕を始めると小さな Chrome のウィンドウが開きます）。Chrome のモードは、確定の字幕と翻訳も Chrome で作ります。翻訳のモデルは初回に Chrome がダウンロードします。「おすすめ」のモードは、話し終えた文を、デドロ字幕のサーバーを通して、文字起こし・用語・翻訳の専用のモデル（Qwen と、OpenRouter のモデル）で作り直します。API キーを使うモードは、その会社のモデルで作り直します。ふりがなと用語の辞書は PC の中にあります。アプリの「その他のモード」には、Chrome を使わないモードや、PC の中の AI だけで作る「ローカル」のモードもあります。",
  },
  {
    q: "どんな情報が送信されますか？",
    a: "初めに選べる 3 つのモード（おすすめ・Chrome・Chrome+）では、字幕を出している間の話し声が、Chrome を通じて Google に送られます。Chrome のモードの字幕の文字は外に送りません。「おすすめ」のモードでは、話している間の話し声と字幕の文字が、デドロ字幕のサーバーを通って、Qwen と OpenRouter に送られます（サーバーは音声と文字を保存しません）。API キーを使うモードでは、話し声と字幕の文字を、選んだ会社（OpenAI など）に送ります。「ローカル」のモードでは、話し声も字幕の文字も PC から出しません（GPU のメモリが 12 GB 以上の PC 向けです）。ランクを出すときは、Steam のアカウント ID を deadlock-api に送ります。",
    link: { href: "/privacy", label: "プライバシーポリシーを見る" },
  },
  {
    q: "API キーはどこに保存されますか？",
    a: "キーは PC の OS の資格情報ストア（Windows の資格情報マネージャー、Mac のキーチェーン）に保存し、その会社との通信にだけ使います。Chrome のモードと「おすすめ」のモードでは、API キーは要りません。",
    link: { href: "/privacy", label: "プライバシーポリシーを見る" },
  },
  {
    q: "ゲームのファイルを変更しますか？",
    a: "しません。ゲームとは別に動くアプリで、ランクは公開されている情報を使います。",
  },
  {
    q: "ウイルスが入っていないか心配です",
    a: "ソースコードは GitHub で公開していて、配布するファイルは GitHub Actions でそのコードから作っています。Windows で「PC が保護されました」と出ることがありますが、Windows 用のコード署名をしていないためで、ウイルスが見つかったという意味ではありません。",
    link: { href: REPO, label: "GitHub でソースコードを見る" },
  },
  {
    q: "どんな人が開発したんですか？",
    a: "Twitch で Deadlock を配信しているミリちゃんねるが、配信者目線で開発しました。",
    photo: miri,
    link: { href: TWITCH, label: "Twitch のチャンネルを見る" },
  },
  {
    q: "わからないことは、どこで聞けますか？",
    a: "Discord のサーバーで、質問などを受け付けています。",
    link: { href: DISCORD, label: "Discord のサーバーに参加する" },
  },
];


/** アイテム説明と正式名の例に使う台詞（「ディスペル」と略して話す文） */
const line = LINES[0]!;
/** 手元の測定（M5 Pro）とリリースのファイルの大きさ */
const lightness = [
  { value: "約 1%", label: "CPU", note: "アプリが字幕を出している間の、1 コアに対する割合" },
  { value: "約 20MB", label: "メモリ", note: "Windows でウィンドウを閉じて、字幕を出しているとき。途中の字幕を作る Chrome のウィンドウの分が、別に約 200MB かかります" },
  { value: "約 20MB", label: "インストーラー", note: "Windows 版" },
];
const cards = await fetchCards();
/** 「ディスペル」と略して話しても、翻訳では正式名になる例（アイテムの略称。スキルの略称は、ヒーローの名前が出ているときだけ） */
const official = [
  { lang: "English", code: "en", name: "Dispel Magic" },
  { lang: "Русский", code: "ru", name: "Развеивание магии" },
  { lang: "中文", code: "zh-Hans", name: "驱散魔法" },
];
/**
 * 検索エンジンに、サイトの名前とアプリの中身を伝える（構造化データ）。
 * Google は WebSite の name を検索結果のサイト名に使う。アプリは無料で、3 つの OS で動く
 */
const site = Astro.site!.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "デドロ字幕",
      alternateName: ["Deadlock 字幕", "deadlock-jimaku"],
      url: site,
      inLanguage: "ja",
    },
    {
      "@type": "SoftwareApplication",
      name: "デドロ字幕",
      description: "Deadlock に特化した、日本語字幕＆翻訳字幕アプリ。ランクやアイテム説明も出せます。",
      url: site,
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Windows 10, Windows 11, macOS 11, Linux",
      downloadUrl: `${REPO}/releases/latest`,
      offers: { "@type": "Offer", price: 0, priceCurrency: "JPY" },
      author: { "@type": "Person", name: "ミリちゃんねる", url: TWITCH },
    },
  ],
};
---

<Layout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="dots px-4 pt-8 sm:pt-7">
    <div class="mx-auto max-w-6xl text-center">
      <h1 class="display text-[clamp(2.5rem,5.6vw,4.5rem)]"><span class="inline-block">デドロ配信を、</span><span class="band inline-block">世界に。</span></h1>
      <p class="mt-4 text-lg text-muted">
        <span class="inline-block">Deadlock に特化した、</span><span class="inline-block">日本語字幕＆翻訳字幕アプリ</span>
      </p>
      <p class="mt-1 text-sm text-muted">Windows 10 / 11・macOS 11 以降・Linux</p>
    </div>

    <LiveDemo client:load cards={cards} />

    <div class="mt-12 text-center">
      <p class="text-sm text-muted">配信で使われています</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-3">
        {
          STREAMERS.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 rounded-full border border-line bg-panel py-1.5 pr-4 pl-1.5 transition-colors hover:border-ink"
              >
                <img src={s.icon} alt="" width="40" height="40" class="size-10 rounded-full border border-line bg-white" />
                <span class="font-bold">{s.name}</span>
                <BrandIcon icon={siTwitch} class="size-4 text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto mt-24 grid max-w-6xl items-center gap-10 px-4 sm:mt-32 md:grid-cols-2">
    <div>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">
        <span class="band">高精度な</span>文字起こし
      </h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        「おすすめ」のモードでは、ゲームの用語や略した呼び方も、正しく書きます。
      </p>
    </div>
    <div class="reveal plate relative h-64 overflow-hidden">
      <div class="plate-caption"><PlateCaption client:visible stage="enriched" line={1} /></div>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div class="reveal plate relative h-64 overflow-hidden">
      <div class="plate-caption"><PlateCaption client:visible stage="translated" line={0} /></div>
    </div>
    <div class="order-first md:order-none">
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">
        <span class="band">ふりがな</span>付きの字幕
      </h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        漢字に読みが付くので、日本語を学んでいる海外の視聴者にも読めます。翻訳も同時に出せます。
      </p>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal max-w-4xl text-[clamp(2.1rem,5.4vw,4.25rem)]">
      <span class="band">ゲームの用語</span>に対応
    </h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      ヒーロー・スキル・アイテムの名前を、色とアイコンで強調します。
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <figure class="reveal">
        <div class="plate flex min-h-[26rem] items-center justify-center p-6">
          <PlateCard client:visible card={cards[line.card]!} />
        </div>
        <figcaption class="mt-4">
          <h3 class="text-xl font-bold">アイテム説明</h3>
          <p class="mt-1 leading-relaxed text-muted">話したアイテムの説明が、そのまま配信に出ます。</p>
        </figcaption>
      </figure>
      <figure class="reveal">
        <div class="flex min-h-[26rem] flex-col justify-center rounded-[20px] bg-panel p-6 sm:p-8">
          <p class="text-sm font-bold text-muted">話した言葉</p>
          <p class="display mt-1 text-4xl">「ディスペル」</p>
          <dl class="mt-6 divide-y divide-line border-t border-line">
            {
              official.map((o) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-sm text-muted">{o.lang}</dt>
                  <dd class="text-right text-lg font-bold" lang={o.code}>{o.name}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <figcaption class="mt-4">
          <h3 class="text-xl font-bold">正式名への翻訳</h3>
          <p class="mt-1 leading-relaxed text-muted">海外の視聴者にも、何の話か伝わります（「おすすめ」のモード）。</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]"><span class="band">ランク</span>の表示</h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        配信にランクを、すっきり出せます。試合が終わると自動で更新します。
      </p>
    </div>
    <div class="reveal plate plate-rank flex flex-col items-center justify-center gap-5 p-6 sm:p-8">
      <div role="img" aria-label="ランクの表示（Emissary III とゲージ）">
        <RankBadge rank={RANK} lang="en" content="gauge" />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div role="img" aria-label="日本語の名前のランクの表示（エミッサリー III）">
          <RankBadge rank={RANK} lang="ja" content="name" />
        </div>
        <div role="img" aria-label="アイコンだけのランクの表示">
          <RankBadge rank={RANK} lang="ja" content="icon" />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <LookDemo client:visible />
    <div class="order-first md:order-none">
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]">文字の見た目を<br /><span class="band">変えられる</span></h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">フォントや色など、文字の見た目を自由に設定できます。</p>
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div>
      <p class="reveal mb-4 inline-block rounded-full border border-line px-3 py-1 text-sm font-bold text-muted tabular-nums">v0.11.0 で追加</p>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]"><span class="band">統計</span>タブ</h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        配信でどれだけ喋ったかが、記録に残ります。よく呼んだヒーローやアイテムも分かります。
      </p>
    </div>
    <div class="reveal plate flex flex-col gap-3 p-4 sm:p-6">
      <img src={statsTotals} alt="統計の合計（字幕を出していた時間、喋った量、よく呼んだヒーロー・アイテム・スキル）" width="1472" height="760" loading="lazy" class="w-full rounded-xl" />
      <img src={statsDays} alt="日ごとの喋った量のヒートマップ" width="1472" height="436" loading="lazy" class="w-full rounded-xl" />
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl items-center gap-10 px-4 sm:mt-40 md:grid-cols-2">
    <div class="reveal plate p-4 sm:p-6">
      <img
        src={purchases}
        alt="買ったアイテムの表示（ミナが買ったスイフトストライカーは購入率 40%、平均の購入 16:36 で「早い」。ミスティックエクスパンダーは 78% で「定番」）"
        width="1080"
        height="680"
        loading="lazy"
        class="w-full rounded-xl"
      />
    </div>
    <div class="order-first md:order-none">
      <p class="reveal mb-4 inline-block rounded-full border border-line px-3 py-1 text-sm font-bold text-muted tabular-nums">v0.12.0 で追加</p>
      <h2 class="display reveal text-[clamp(2.1rem,4.5vw,3.6rem)]"><span class="band">買ったアイテム</span>の表示</h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-muted">
        ゲームでアイテムを買うと、配信に小さく出します。購入率などの統計も付きます。
      </p>
      <p class="reveal mt-3 text-lg leading-relaxed text-muted">Windows 版だけの機能です。見た目を変える MOD を入れていると動きません。</p>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      ゲームが<span class="band">重くならない</span>
    </h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      文字起こしをクラウドで動かすので、ゲーム中の PC に重い処理をさせません。
    </p>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        lightness.map((l) => (
          <li class="reveal border-t-2 border-ink pt-4">
            <p class="display text-5xl">{l.value}</p>
            <h3 class="mt-2 font-bold">{l.label}</h3>
            <p class="mt-1 text-sm text-muted">{l.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4 text-center sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      OBS に<span class="band">ドラッグで追加</span>
    </h2>
    <p class="reveal mx-auto mt-5 max-w-2xl text-lg text-muted">
      見せ方はアプリの画面で変えられます。一度追加すれば、貼り直す必要はありません。
    </p>
    <video
      data-play-in-view
      class="reveal mx-auto mt-10 w-full rounded-[clamp(14px,2.2vw,28px)]"
      src={obsVideo}
      poster={obsPoster}
      width="1280"
      height="608"
      muted
      loop
      playsinline
      preload="none"
      aria-label="操作パネルの「ここを OBS にドラッグして追加」を OBS にドラッグして字幕のソースを足し、位置を動かす画面録画"
    ></video>
  </section>

  <section id="modes" class="mx-auto mt-28 max-w-6xl px-4 sm:mt-40">
    <h2 class="display reveal text-[clamp(2.1rem,5.4vw,4.25rem)]">
      3 つの<span class="band">モード</span>
    </h2>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        MODES.filter((e) => !e.more).map((e) => (
          <li class="reveal border-t-2 border-ink pt-4">
            <h3 class="flex items-center gap-2 text-xl font-bold">
              {e.label}
              {e.badge && <span class="bg-ink px-2 py-0.5 text-xs text-paper">{e.badge}</span>}
            </h3>
            <p class="mt-2 text-sm font-bold">{e.traits.join("・")}</p>
            <p class="display mt-3 text-3xl">{price(e.hourlyUsd)}</p>
            <p class="mt-3 leading-relaxed text-muted">{e.hint}</p>
          </li>
        ))
      }
    </ul>
    <!-- 3 つとも要るものは、モードごとに繰り返さず、下に 1 つだけ出す -->
    <div class="reveal mt-10 flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t-2 border-ink pt-4">
      <p class="font-bold">3 つとも必要なもの</p>
      <p class="text-muted">Google Chrome（字幕を始めると、小さなウィンドウが開きます）</p>
    </div>
    <p class="reveal mt-6 leading-relaxed text-muted">
      Chrome を使わないモードや、ローカルの AI を使うモードなど、ほかのモードもあります。工程ごとにカスタマイズすることもできます。
      <a href="/models" class="underline hover:text-ink">モデルの測定結果を見る</a>
    </p>
  </section>

  <section id="pricing" class="mt-28 bg-ink text-paper sm:mt-40">
