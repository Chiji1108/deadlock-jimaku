---
import Layout from "../layouts/Layout.astro";

const DOWNLOAD = "https://github.com/Chiji1108/deadlock-stream-overlays/releases/latest";

const features = [
  {
    title: "リアルタイム字幕",
    body: "話している途中から字幕が出て、話し終えると精度の高い文に置き換わります。ヒーロー・アイテム・スキルの名前は色付きで強調し、「拡マガ」「ウルト」のような略し方も聞き分けます。",
  },
  {
    title: "ふりがなと翻訳",
    body: "漢字にはふりがなを付け、英語や韓国語など最大 4 つの言語に同時に翻訳します。翻訳ではゲーム内の正式な名前に置き換わるので、海外の視聴者にも伝わります。",
  },
];

/**
 * 配信画面の見本（Windows の OBS で撮った実際の配信画面、1920×1080）。
 * 枠の位置は画面に対する割合で、下の拡大図はこの画面から切り出したもの
 */
const parts = [
  {
    name: "字幕",
    frame: { left: 31.25, top: 62, width: 38.5, height: 22.7 },
    image: "/sample/captions-real.webp",
    size: [740, 245],
    alt: "字幕（ドアマンのウルトは強い。デスチーターにはカースを買え。と、その英訳）",
    body: "話した言葉に、アイコン・色・ふりがなを付けて出します。下の行は英訳で、「ウルト」「カース」のような呼び方も正式な名前（Hotel Guest、Cursed Relic）になります。",
  },
  {
    name: "アイテム説明",
    frame: { left: 78.1, top: 19.4, width: 21.5, height: 40 },
    image: "/sample/items-real.webp",
    size: [412, 432],
    alt: "アイテム説明のカード（デスチーター）",
    body: "字幕にアイテム名が出たら、ゲーム内と同じカードで説明を出します。",
  },
  {
    name: "ランク",
    frame: { left: 0.3, top: 0.5, width: 17.5, height: 8 },
    image: "/sample/rank-real.webp",
    size: [340, 90],
    alt: "ランクの表示（エミッサリー III）",
    body: "今のランクと、次のランクまでのポイントを出します。試合が終わると自動で更新します。",
  },
] as const;

const steps = [
  { title: "ダウンロード", body: "Windows・Mac・Linux 用のアプリを入れます。" },
  {
    title: "OpenAI の API キーを設定",
    body: "文字起こしと翻訳に使います。キーは PC の資格情報ストアに保存します。",
  },
  {
    title: "OBS に URL を貼る",
    body: "アプリの画面でコピーした URL を、OBS のブラウザソースに貼るだけです。見せ方はアプリの画面で変えられます。",
  },
];

const faqs = [
  {
    q: "ゲームの PC に何か入れたり、ゲームのファイルを触ったりしますか？",
    a: "しません。マイクの声と、公開されているランクの情報だけを使います。",
  },
  {
    q: "日本語以外で話しても使えますか？",
    a: "使えます。話す言語は操作画面で選べます。ふりがなは日本語のときだけ付きます。",
  },
  {
    q: "OpenAI の料金が心配です",
    a: "アプリの「料金」タブに、使った分の目安がその場で出ます。OpenAI のダッシュボードで上限を決めておくと安心です。",
  },
];
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 pt-20 pb-16">
    <p class="text-sm font-medium text-gold">デドロ字幕 ─ Deadlock 配信者のための OBS オーバーレイ</p>
    <h1 class="mt-3 text-3xl leading-tight font-bold tracking-tight sm:text-5xl">
      話した言葉が、そのまま<br />読める字幕になる。
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      ふりがなと翻訳つきのリアルタイム字幕、ランク、アイテム説明を、OBS
      にそのまま重ねられます。アプリは無料です。
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={DOWNLOAD}
        class="rounded-lg bg-gold px-5 py-3 font-semibold text-ink transition hover:brightness-110"
      >
        ダウンロード
      </a>
      <span class="text-sm text-muted">Windows 10 / 11・macOS 11 以降・Linux</span>
    </div>

    <!-- 配信画面の見本: OBS で撮った実際の画面に、どれが何かを枠で示す（枠は画面の幅に合わせて縮む） -->
    <figure class="mt-14">
      <div class="relative overflow-hidden rounded-xl border border-line">
        <img
          src="/sample/game.webp"
          alt="配信画面の見本。左上にランク、右にアイテム説明のカード、下の中央に字幕"
          width="1920"
          height="1080"
          fetchpriority="high"
          class="block w-full"
        />
        {
          parts.map(({ name, frame }) => (
            <div
              class="frame"
              style={`left:${frame.left}%;top:${frame.top}%;width:${frame.width}%;height:${frame.height}%`}
            >
              <span
                class:list={[
                  "frame-label",
                  frame.top < 5 && "below",
                  frame.left + frame.width > 90 && "end",
                ]}
              >
                {name}
              </span>
            </div>
          ))
        }
      </div>
      <figcaption class="mt-3 text-xs text-muted">
        Windows の OBS で撮った実際の配信画面。字幕・アイテム説明・ランクは、どれも好きな位置と大きさに置けます
      </figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">できること</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        features.map((f) => (
          <div class="rounded-xl border border-line bg-panel p-6">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">オーバーレイ</h2>
    <p class="mt-3 text-muted">どれも OBS のブラウザソースに URL を貼るだけで、背景は透明です。</p>
    <div class="mt-8 grid items-start gap-6 sm:grid-cols-2">
      {
        parts.map((o, i) => (
          <figure class:list={["stage p-6", i === 0 && "sm:col-span-2"]}>
            <img
              src={o.image}
              alt={o.alt}
              width={o.size[0]}
              height={o.size[1]}
              loading="lazy"
              decoding="async"
              class="mx-auto w-full rounded-md"
              style={`max-width:${o.size[0]}px`}
            />
            <figcaption class="mt-5">
              <h3 class="font-semibold">{o.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{o.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">はじめかた</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-line p-6">
            <span class="text-sm font-semibold text-gold">{i + 1}</span>
            <h3 class="mt-2 font-semibold">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="pricing" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">料金</h2>
    <div class="mt-8 rounded-xl border border-line bg-panel p-6 sm:p-8">
      <p class="text-lg">
        アプリは<strong class="text-gold">無料</strong>です。文字起こしと翻訳には、ご自身の OpenAI
        の API キーを使います。
      </p>
      <p class="mt-4 text-muted">
        OpenAI への支払いの目安は、ずっと話し続けて <strong class="text-white">1 時間あたり約 $2</strong>（翻訳
        1 言語・ふりがなあり）です。話していない間は音声を送らないので、黙っている時間が長いほど少なくなります。翻訳先を
        1 つ増やすと、話し続けて 1 時間あたり約 $0.3 増えます。
      </p>
    </div>
  </section>

  <section id="faq" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold">よくある質問</h2>
    <dl class="mt-8 divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <div class="py-6">
            <dt class="font-semibold">{f.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
