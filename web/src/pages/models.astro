---
import Layout from "../layouts/Layout.astro";
import { FURIGANA, TERMS, TRANSCRIBE, TRANSLATE, type Row } from "../lib/models";

const date = (day: string) => {
  const [y, m, d] = day.split("-").map(Number);
  return `${y} 年 ${m} 月 ${d} 日`;
};
/** 何も聞かない行（辞書だけ）は、時間がない。PC の中で動くものは、料金がない */
const seconds = (ms: number | null) => (ms === null ? "—" : `${(ms / 1000).toFixed(2)} 秒`);
const percent = (part: number, whole: number) => `${((part * 100) / whole).toFixed(1)}%`;
const dollars = (r: Row) => (r.usd ? `$${r.usd.toFixed(4)}` : "—");
/** 表の上に出す、測った日（行ごとに違えば並べる） */
const days = (rows: Row[]) => [...new Set(rows.map((r) => r.measured))].sort().map(date).join("、");
/** 測った日が行ごとに違う表は、行にも日を出す */
const mixed = (rows: Row[]) => new Set(rows.map((r) => r.measured)).size > 1;

interface Column {
  label: string;
  value: (row: Row) => string | number;
  /** 最初の列の数字の、分母（「188 / 189」の 189）。なければ表の回数 */
  outOf?: number;
}
/** どの表にもある列。前に、その工程で数えたものの列を置く（最初の列がいちばん見てほしい数字） */
const common = (runs: number): Column[] => [
  { label: "失敗", value: (r) => r.failed },
  { label: "応答（中央値）", value: (r) => seconds(r.medianMs) },
  { label: "遅いとき", value: (r) => seconds(r.p90Ms) },
  { label: `${runs} 回の料金`, value: dollars },
];

const tables = [
  {
    id: "translate",
    /** サーバーでの仕事の名前（`/v2/models` の答えのキー） */
    task: "translate",
    title: "翻訳",
    ...TRANSLATE,
    columns: [
      { label: "用語を出せた回数", value: (r) => r.shown!.both },
      { label: "英語", value: (r) => r.shown!.en },
      { label: "ロシア語", value: (r) => r.shown!.ru },
      { label: "括弧ごと", value: (r) => r.ok! },
    ] as Column[],
    how: [
      `配信で話しそうな 63 の文を 3 回ずつ、合わせて ${TRANSLATE.runs} 回、日本語から英語とロシア語に訳させました。文の中のゲームの用語（ヒーロー・アイテム・スキル）は、先に英語の正式名に置き換え、⟦Haze⟧ のように括弧で囲んで渡します。`,
      "数えたのは、渡した名前を全部、アプリが訳文から用語として出せた回です（英語とロシア語の両方で出せた回数と、言語ごとの回数）。アプリは、括弧が外れていても、引用符で囲まれていても、大文字と小文字が違っても、名前を見つけて用語にします。名前を訳した、抜かした、余計に書いた回は、出せていません。訳の自然さは数えていません。",
      "「括弧ごと」の列は、もっと厳しい数え方です。2 言語とも、名前が括弧の付いたまま残り、語尾が付かず、日本語も残らなかった回を数えます。",
      "翻訳専門のモデルには言語ごとに 1 回ずつ同時に送り、ほかのモデルには 2 言語をまとめて 1 回で訳させています。推論は止めています（止められないモデルは、いちばん弱い指定にしました）。",
    ],
  },
  {
    id: "terms",
    task: "decide",
    title: "用語の判定",
    ...TERMS,
    columns: [{ label: "合っていた回数", value: (r) => r.ok! }] as Column[],
    how: [
      `同じ 63 の文を 3 回ずつ、合わせて ${TERMS.runs} 回。アプリが PC の中の辞書から出した用語の候補を、判定モデルに確かめさせました。`,
      "その文の用語をすべて見つけ、ふつうの言葉（「シルバー帯」のシルバーなど）を用語にしなかった回を「合っていた」と数えます。",
    ],
  },
  {
    id: "furigana",
    // ふりがなは、用語の判定と同じモデルに頼む
    task: "decide",
    title: "ふりがな",
    ...FURIGANA,
    columns: [
      { label: "正しく読めた回数", value: (r) => r.right! },
      { label: "直した", value: (r) => r.fixed! },
      { label: "壊した", value: (r) => r.broken! },
    ] as Column[],
    how: [
      `読みが分かれる漢字（「辛い」「人気」など）を含む 60 の文を 3 回ずつ、合わせて ${FURIGANA.runs} 回。文の漢字の読みがすべて正しかった回を「正しく読めた」と数えます。`,
      "ふりがなは、まず PC の中の辞書が付けます。「直した」は、辞書では違っていた読みを正しくした回。「壊した」は、辞書では合っていた読みを変えて、違えた回です。判定モデルには辞書の出した候補から選ばせ、GPT には文の読みを直させています。",
    ],
  },
  {
    id: "transcribe",
    task: "transcribe",
    title: "確定の文字起こし",
    ...TRANSCRIBE,
    columns: [
      { label: "書けた用語", value: (r) => r.termsWritten!, outOf: TRANSCRIBE.rows[0]!.terms },
      { label: "文字の誤り", value: (r) => percent(r.characterErrors!, r.characters!) },
    ] as Column[],
    how: [
      `ゲームの用語を入れた 42 の台詞を、3 人の合成音声に読ませた ${TRANSCRIBE.runs} 本の録音を、1 本ずつ文字にさせました。アプリと同じく、辞書の名前をヒントとして渡しています。`,
      "「書けた用語」は、台詞に出てくる用語 207 個のうち、正しい書き方で文字になった数です。「文字の誤り」は、正解の文と違っていた文字の割合（句読点と空白は数えない）で、小さいほど正確です。",
      "合成音声は、本物の話し声より聞き取りやすいので、配信での数字はこれより悪くなります。PC の中で動くものの応答は、測った PC での時間です。",
    ],
  },
];

/** 狭い画面では、行を 1 つの箱にして、数字の上に欄の名前を出す */
const cell =
  "py-3 tabular-nums whitespace-nowrap md:px-3 md:text-right max-md:py-0 max-md:before:block max-md:before:text-xs max-md:before:text-muted max-md:before:content-[attr(data-label)]";
---

<Layout
  title="モデルの測定結果"
  description="デドロ字幕が翻訳と用語の判定に使うモデルを、同じ文で測って比べた結果。用語を出せた回数、応答の速さ、料金。"
>
  <div class="mx-auto max-w-6xl px-4 pt-16">
    <h1 class="display text-[clamp(2.1rem,5.4vw,4.25rem)]">
      モデルは、<span class="band">測って選ぶ。</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      デドロ字幕が使うモデルは、Deadlock の配信の文で測って決めています。その結果を載せます。料金と速さは変わっていくので、測った日を添えています。
    </p>

    <nav aria-label="工程" class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-bold">
      {
        tables.map((t) => (
          <a href={`#${t.id}`} class="underline underline-offset-4 hover:text-muted">
            {t.title}
          </a>
        ))
      }
    </nav>

    {
      tables.map((t) => (
        <section id={t.id} class="mt-20">
          <h2 class="display text-[clamp(1.75rem,3.6vw,2.6rem)]">{t.title}</h2>
          <div class="mt-5 max-w-3xl leading-relaxed text-muted [&_p]:mt-3">
            {t.how.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <p class="mt-8 text-sm font-bold">測った日: {days(t.rows)}</p>
          <table data-task={t.task} class="mt-3 w-full border-t-2 border-ink text-left max-md:block">
            <thead class="text-sm whitespace-nowrap text-muted max-md:hidden">
              <tr>
                <th class="py-3 font-normal">モデル</th>
                {[...t.columns, ...common(t.runs)].map((c) => (
                  <th class="px-3 py-3 text-right font-normal last:pr-0">{c.label}</th>
                ))}
              </tr>
            </thead>
            <tbody class="max-md:block">
              {t.rows.map((r) => (
                <tr data-server={r.server?.join(" ")} class="border-t border-line align-top max-md:grid max-md:grid-cols-3 max-md:gap-x-4 max-md:gap-y-3 max-md:py-5">
                  <th scope="row" class="py-3 pr-3 font-normal max-md:col-span-3 max-md:py-0">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-bold">
                      {r.name}
                      {r.server && <span data-in-use hidden class="bg-ink px-2 py-0.5 text-xs text-paper">「おすすめ」で使用中</span>}
                    </span>
                    <span class="mt-0.5 block text-sm text-muted">
                      {r.via}
                      {mixed(t.rows) && `・${date(r.measured)}`}
                    </span>
                    {r.note && <span class="mt-1 block max-w-md text-sm leading-relaxed text-muted">{r.note}</span>}
                  </th>
                  {[...t.columns, ...common(t.runs)].map((c, i) => (
                    <td class={`${cell} last:md:pr-0 ${i === 0 ? "font-bold" : ""}`} data-label={c.label}>
                      {c.value(r)}
                      {i === 0 && <span class="text-sm font-normal text-muted"> / {c.outOf ?? t.runs}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p data-other hidden class="mt-4 text-sm text-muted">
            今の「おすすめ」のモードは、この表にない <span data-label class="font-bold text-ink" /> を使っています。
          </p>
        </section>
      ))
    }

    <p class="mt-12 max-w-3xl text-sm leading-relaxed text-muted">
      「失敗」は、時間切れ（8 秒）や、送り先に断られて答えが返らなかった回数です（出せた回数や合っていた回数には入りません。時間切れの回は、料金にも入っていません）。「遅いとき」は、10 回に 1
      回はこれより遅い、という時間です。応答は日本から測っています。同じ文と同じ数え方で測った結果だけを並べています。応答と料金は測った日のものなので、日が違う行は目安として見てください。「おすすめ」のモードが使うモデルは、アプリを更新しなくても替わることがあります。印は、ページを開いたときにサーバーに聞いて付けています。
    </p>
  </div>

  <script>
    // 「おすすめ」のモードが今使っているモデルに印を付ける。管理画面で替えられるので、ビルドのときではなく、ページを開くたびに
    // サーバーに聞く。読めなければ、印なしのまま（表はそのまま読める）
    try {
      const res = await fetch("https://api.jimaku.deadlock.jp/v2/models", { signal: AbortSignal.timeout(5000) });
      const inUse = (res.ok ? await res.json() : {}) as Record<string, { id: string; label: string } | undefined>;
      for (const table of document.querySelectorAll<HTMLElement>("[data-task]")) {
        const model = inUse[table.dataset.task!];
        if (!model) continue;
        const rows = [...table.querySelectorAll<HTMLElement>("[data-server]")];
        const row = rows.find((r) => r.dataset.server!.split(" ").includes(model.id));
        const other = table.parentElement!.querySelector<HTMLElement>("[data-other]")!;
        if (row) row.querySelector<HTMLElement>("[data-in-use]")!.hidden = false;
        else {
          other.querySelector("[data-label]")!.textContent = model.label;
          other.hidden = false;
        }
      }
    } catch {
      // サーバーに届かない、答えが読めない
    }
  </script>
</Layout>
