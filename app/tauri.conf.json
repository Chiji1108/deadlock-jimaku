{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "デドロ字幕",
  "mainBinaryName": "deadlock-jimaku",
  "identifier": "dev.deadlock-stream-overlays.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "replaces": [
          "dedoro-jimaku"
        ],
        "conflicts": [
          "dedoro-jimaku"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ],
        "obsoletes": [
          "dedoro-jimaku"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRDk3MDUwNjQ1QjQzRjgKUldUNFExdGtVSERaVXBNUWcrREp0ckFCWGJHM01TTHZ6SisxWmduNEJKdFBCdWZjU1luMm9WRW0K",
      "endpoints": [
        "https://github.com/Chiji1108/deadlock-jimaku/releases/latest/download/latest.json"
      ]
    }
  }
}
